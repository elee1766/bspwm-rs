#!/bin/sh
set -u
. "$TEST_ROOT/prelude"

assert_eq 0 "$(node_count)" "initial node count"
xid=$(add_test_window manage ScenarioManage)
assert_eq 1 "$(node_count)" "node count after map"
tree=$($BSPC query -T -n "$xid")
assert_eq ScenarioManage "$(printf '%s' "$tree" | jq -r '.client.className')" "managed class"
assert_eq tiled "$(printf '%s' "$tree" | jq -r '.client.state')" "initial state"

$BSPC node "$xid" --state floating
assert_eq floating "$($BSPC query -T -n "$xid" | jq -r '.client.state')" "changed state"
close_test_window "$xid"
assert_eq 0 "$(node_count)" "node count after close"
