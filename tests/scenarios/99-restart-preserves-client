#!/bin/sh
set -u
. "$TEST_ROOT/prelude"

# --- Basic restart: client survives, socket preserved ---
xid=$(add_test_window restart ScenarioRestart)
socket_before=$($BSPC --print-socket-path)
assert_eq "$BSPWM_SOCKET" "$socket_before" "socket path before restart"
$BSPC wm --restart
poll_until 100 0.05 node_exists "$xid" || fail "client was not restored after daemon restart"

socket_after=$($BSPC --print-socket-path)
assert_eq "$BSPWM_SOCKET" "$socket_after" "socket path after restart"
assert_eq "$socket_before" "$socket_after" "socket identity after restart"
assert_eq ScenarioRestart "$($BSPC query -T -n "$xid" | jq -r '.client.className')" "client class after restart"

# --- State preserved across restart ---
$BSPC node "$xid" --state floating
$BSPC node "$xid" --layer above
$BSPC wm --restart
poll_until 100 0.05 node_exists "$xid" || fail "client lost after second restart"
assert_eq floating "$($BSPC query -T -n "$xid" | jq -r '.client.state')" "floating state after restart"
assert_eq above "$($BSPC query -T -n "$xid" | jq -r '.client.layer')" "above layer after restart"

# --- Stacking order preserved: tiled below floating ---
$BSPC node "$xid" --state tiled --layer normal
tiled=$(add_test_window restart-tiled ScenarioRestart)
float=$(add_test_window restart-float ScenarioRestart)
$BSPC node "$float" --state floating
$BSPC node "$tiled" --focus
sleep 0.1

$BSPC wm --restart
poll_until 100 0.05 node_exists "$tiled" || fail "tiled client lost after restart"
poll_until 100 0.05 node_exists "$float" || fail "floating client lost after restart"
# After restart, floating must be above tiled in X stack.
poll_until 50 0.05 x_window_above "$float" "$tiled" \
	|| fail "floating not above tiled after restart"

# --- Exact within-level stacking order preserved across restart ---
fa=$(add_test_window restart-fa ScenarioRestart)
fb=$(add_test_window restart-fb ScenarioRestart)
fc=$(add_test_window restart-fc ScenarioRestart)
$BSPC node "$fa" --state floating
$BSPC node "$fb" --state floating
$BSPC node "$fc" --state floating
# Focus order: fc, fb, fa -- each raise puts window on top of level.
# Result: fa on top, fb below, fc at bottom.
$BSPC node "$fc" --focus
$BSPC node "$fb" --focus
$BSPC node "$fa" --focus
sleep 0.1

# Verify pre-restart order: fa above fb above fc.
x_window_above "$fa" "$fb" || fail "fa not above fb before restart"
x_window_above "$fb" "$fc" || fail "fb not above fc before restart"

$BSPC wm --restart
poll_until 100 0.05 node_exists "$fa" || fail "fa lost after restart"
poll_until 100 0.05 node_exists "$fb" || fail "fb lost after restart"
poll_until 100 0.05 node_exists "$fc" || fail "fc lost after restart"

# The exact within-level order must be preserved: fa above fb above fc.
poll_until 50 0.05 x_window_above "$fa" "$fb" \
	|| fail "within-level order not preserved: fa not above fb after restart"
x_window_above "$fb" "$fc" \
	|| fail "within-level order not preserved: fb not above fc after restart"

close_test_window "$fc"
close_test_window "$fb"
close_test_window "$fa"

# --- Transient relationship preserved across restart ---
parent=$(add_controlled_window r-parent r-parent ScenarioRestart)
child=$(add_controlled_window r-child r-child ScenarioRestart --transient-for "$parent")
$BSPC node "$parent" --state floating
$BSPC node "$child" --state floating
$BSPC node "$parent" --focus
poll_until 50 0.05 x_window_above "$child" "$parent" \
	|| fail "transient child not above parent before restart"

$BSPC wm --restart
poll_until 100 0.05 node_exists "$parent" || fail "parent lost after restart"
poll_until 100 0.05 node_exists "$child" || fail "child lost after restart"
# Re-focus parent after restart -- child must still be above.
$BSPC node "$parent" --focus
poll_until 50 0.05 x_window_above "$child" "$parent" \
	|| fail "transient child not above parent after restart"

close_test_window "$child"
close_test_window "$parent"
close_test_window "$float"
close_test_window "$tiled"
close_test_window "$xid"
